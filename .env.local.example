# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Supabase service key — NEVER expose this on the client.
# El código lee SUPABASE_SECRET_KEY (src/lib/supabase/service.ts).
SUPABASE_SECRET_KEY=your-service-role-key

# Direct PostgreSQL connection string for Drizzle ORM
# Format: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Jira MCP
JIRA_API_TOKEN=your-jira-api-token

# App base URL — used to build absolute redirect links in emails and Mercado Pago return URLs
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# Resend — transactional email (get API key from resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be a verified domain in Resend (e.g. "IICANA <noreply@iicana.edu.ar>")
RESEND_FROM_EMAIL=IICANA <noreply@iicana.edu.ar>

# Secret that authorizes the Vercel cron endpoints (/api/cron/*)
CRON_SECRET=a-long-random-string

# Módulo de Pagos ---------------------------------------------------------------
# Dirección institucional que además de los directores recibe el aviso "Notificación de retiro de caja" (opcional)
CASH_ALERT_EMAIL=

# Mercado Pago (Checkout Pro). Credenciales de la aplicación en https://www.mercadopago.com.ar/developers
# Sandbox: usá el Access Token de prueba (TEST-...) y usuarios de prueba. Producción: APP_USR-...
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de la firma de notificaciones (Tu aplicación > Webhooks > Configurar notificaciones)
MERCADOPAGO_WEBHOOK_SECRET=
# sandbox | production (por defecto sandbox)
MERCADOPAGO_ENV=sandbox
