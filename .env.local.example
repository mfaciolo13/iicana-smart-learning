# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Supabase service role key — NEVER expose this on the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct PostgreSQL connection string for Drizzle ORM
# Format: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Jira MCP
JIRA_API_TOKEN=your-jira-api-token

# Resend — transactional email (get API key from resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be a verified domain in Resend (e.g. "IICANA <noreply@iicana.edu.ar>")
RESEND_FROM_EMAIL=IICANA <noreply@iicana.edu.ar>
